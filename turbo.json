{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NEXT_PUBLIC_SUPABASE_URL",
    "SUPABASE_SERVICE_ROLE_KEY",
    "ENCRYPTION_KEY",
    "SUPABASE_URL",
    "SUPABASE_ANON_KEY",
    "FRONTEND_URL",
    "USUARIOS_API_URL",
    "DOCUMENTOS_API_URL",
    "FACTURACION_API_URL",
    "AUDITORIA_API_URL",
    "AUDIT_WORKER_SECRET",
    "AUDIT_POLL_MS",
    "AUDIT_POLLER",
    "MP_ACCESS_TOKEN",
    "MP_CURRENCY",
    "MP_BACK_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}